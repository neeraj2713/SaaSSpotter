# Application
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=painpoint

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Firecrawl (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# Scraping — Firecrawl search targets (site: queries) and complaint keywords
SCRAPE_TARGETS=reddit.com/r/Entrepreneur,reddit.com/r/SaaS,reddit.com/r/startups,reddit.com/r/smallbusiness
SCRAPE_KEYWORDS=frustrated,struggling,wish there was,problem with,how do you handle,any tool for
SCRAPE_POST_LIMIT=50

# API
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=

# Local development
LOCAL_PIPELINE_MODE=true
SKIP_AWS_SECRETS=true

# AWS (production — leave empty for local dev)
AWS_REGION=ap-south-1
AWS_SECRETS_MANAGER_SECRET_NAME=
STEP_FUNCTIONS_STATE_MACHINE_ARN=

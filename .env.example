# Application
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=painpoint

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=PainPoint.io/1.0 by your_username

# Scraping
SCRAPE_SUBREDDITS=Entrepreneur,SaaS,startups,smallbusiness
SCRAPE_KEYWORDS=frustrated,struggling,wish there was,problem with,how do you handle,any tool for
SCRAPE_POST_LIMIT=50

# API
CORS_ORIGINS=http://localhost:3000
ADMIN_API_KEY=

# Local development
LOCAL_PIPELINE_MODE=false

# AWS (production — can also be loaded from Secrets Manager)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_SECRET_NAME=
STEP_FUNCTIONS_STATE_MACHINE_ARN=
